# Copy to .env and fill in. Never commit .env.

# --- SEC EDGAR (required) ---
# SEC asks for a name and a contact email in every request's User-Agent.
SEC_USER_AGENT="Name email"

# --- Database ---
DATABASE_URL=postgresql+psycopg://filinglens:filinglens@localhost:5432/filinglens

# --- LLM (provider: openai | anthropic) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# 0 = reproducible evals. Leave empty for models that reject a temperature (reasoning models).
LLM_TEMPERATURE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings (always OpenAI: Anthropic has no embeddings API) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Langfuse (optional until M6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local paths ---
DATA_DIR=data
