# Copy to .env and fill in. Never commit .env.

# --- SEC EDGAR (required) ---
# SEC asks for a name and a contact email in every request's User-Agent.
SEC_USER_AGENT="Name email"

# --- Database ---
DATABASE_URL=postgresql+psycopg://filinglens:filinglens@localhost:5432/filinglens

# --- LLM (provider: openai | anthropic) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-6-luna
# Leave empty for models that reject a temperature (reasoning models, current Claude models).
LLM_TEMPERATURE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Eval judge: a different model family from the answerer (no self-grading) ---
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-5-5
# Leave empty: current Claude and OpenAI reasoning models reject a temperature.
JUDGE_TEMPERATURE=

# --- Embeddings (always OpenAI: Anthropic has no embeddings API) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Langfuse (optional until M6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Local paths ---
DATA_DIR=data
